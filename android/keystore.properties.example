# Copy this file to android/keystore.properties (gitignored) and fill in
# values from a keystore YOU create. Do not commit passwords.
#
# Example (run locally; it will prompt — do not paste the password into git):
#   keytool -genkeypair -v -keystore pixelcut-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias pixelcut
#
# storeFile may be absolute or relative to the android/ directory.

storeFile=pixelcut-release.jks
storePassword=
keyAlias=pixelcut
keyPassword=
